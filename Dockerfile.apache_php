FROM php:8.2.4-fpm

# Install PHP extensions [[2]][[4]]
RUN docker-php-ext-install \
    mbstring \
    pdo_mysql \
    gd \
    xsl \
    xmlrpc \
    soap \
    intl \
    zip \
    bcmath \
    opcache

# Install SQLite 3.38.5 and SQLite 2.8.17
RUN apt-get update && apt-get install -y \
    sqlite3=3.38.5 \
    libsqlite3-dev=3.38.5 \
    sqlite=2.8.17-15

# Install OpenSSL 1.1.1w, Freetype2, libpng, etc.
RUN apt-get install -y \
    openssl=1.1.1w \
    libfreetype6-dev=2.4.8-1 \
    libpng-dev=1.6.37 \

# Configure Apache (if using mod_php instead of PHP-FPM)
# Note: The base image uses PHP-FPM by default. For Apache + mod_php, use:
# FROM php:8.2.4-apache [[1]]
# and enable mods like mod_rewrite.